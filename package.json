{
  "name": "marketplace-api",
  "version": "1.0.0",
  "private": true,
  "description": "hw-09 — Marketplace API: OpenAPI-контракт + runtime-валідація на кордоні (варіант Б, NestJS + express-openapi-validator)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:spec": "npm run bundle:spec && node scripts/check-spec.cjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "express-openapi-validator": "5.6.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@redocly/cli": "2.46.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "typescript": "5.4.5"
  }
}
