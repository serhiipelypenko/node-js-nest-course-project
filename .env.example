# Контракт змінних середовища. Реальні значення — у .env (він у .gitignore).
# Кожен ключ тут МУСИТЬ збігатися з src/config/env.schema.ts (перевіряє
# `npm run check:env`). Секретні значення — фейкові.

# Режим роботи: development | production | test
NODE_ENV=development

# Порт HTTP-сервера
PORT=3000

# DSN Postgres БЕЗ пароля — host/port/db/user. Пароль читається окремо
# з файла DB_PASSWORD_FILE на кожне нове зʼєднання.
# hw-15: хост/порт — PgBouncer (6432), а не прямий Postgres (5432).
DB_URL=postgres://marketplace@localhost:6432/marketplace

# Шлях до файла-секрета з паролем ролі БД (у git і в docker-образ не потрапляє)
DB_PASSWORD_FILE=./secrets/db_password

# ── hw-24: автентифікація ──────────────────────────────────────────────
# Секрети тут ПОРОЖНІ навмисно: значення приходять зі сховища (hw-11) через
# `bash scripts/with-secrets.sh dev …` або з оточення при SKIP_VAULT=1.
# Без них `npm run start` падає і називає змінну; у схемі дефолтів немає.
# PEM кладемо в base64 одним рядком (див. README «Auth»).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
REFRESH_TOKEN_PEPPER=

# Overlap-ротація: попередній публічний ключ (обидва разом або жодного)
JWT_PREVIOUS_KID=
JWT_PREVIOUS_PUBLIC_KEY=

# Життя токенів, секунди: access 600 (10 хв), refresh 604800 (7 діб)
ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_SEC=604800

# ── hw-26: файли (S3-сумісне сховище) ──────────────────────────────────
# Ключі доступу ПОРОЖНІ навмисно: значення приходять зі сховища (hw-11) через
# `bash scripts/with-secrets.sh dev …` або з оточення при SKIP_VAULT=1.
# ENDPOINT порожній => справжній AWS S3; для MinIO з compose: http://127.0.0.1:22650
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Строки presigned (секунди) і поріг multipart (байти) — README, ## Files
STORAGE_PUT_EXPIRES_SEC=300
STORAGE_PART_EXPIRES_SEC=900
STORAGE_GET_EXPIRES_SEC=60
STORAGE_MULTIPART_THRESHOLD=8388608
