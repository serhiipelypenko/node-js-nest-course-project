{
  "roleArn": "arn:aws:iam::396231126131:role/hw31-ci-teardown-97eec71",
  "trustPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::396231126131:oidc-provider/token.actions.githubusercontent.com"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
          },
          "StringLike": {
            "token.actions.githubusercontent.com:sub": [
              "repo:serhiipelypenko/node-js-nest-course-project:*",
              "repo:serhiipelypenko@*/node-js-nest-course-project@*:*"
            ]
          }
        }
      }
    ]
  },
  "permissionPolicies": [
    {
      "name": "hw31-ci-teardown-policy-bd1aabf",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Action": [
              "s3:ListBucket",
              "s3:GetBucketLocation"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::hw31-pulumi-state-396231126131",
            "Sid": "StateBucket"
          },
          {
            "Action": [
              "s3:GetObject",
              "s3:PutObject",
              "s3:DeleteObject"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::hw31-pulumi-state-396231126131/*",
            "Sid": "StateObjects"
          },
          {
            "Action": [
              "rds:DeleteDBInstance",
              "rds:DescribeDBInstances",
              "rds:DeleteDBSubnetGroup",
              "rds:DescribeDBSubnetGroups",
              "rds:ListTagsForResource"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "Rds"
          },
          {
            "Action": [
              "elasticloadbalancing:DeleteLoadBalancer",
              "elasticloadbalancing:DeleteListener",
              "elasticloadbalancing:DeleteTargetGroup",
              "elasticloadbalancing:DeregisterTargets",
              "elasticloadbalancing:DescribeLoadBalancers",
              "elasticloadbalancing:DescribeListeners",
              "elasticloadbalancing:DescribeTargetGroups",
              "elasticloadbalancing:DescribeTargetHealth",
              "elasticloadbalancing:DescribeLoadBalancerAttributes",
              "elasticloadbalancing:DescribeTargetGroupAttributes",
              "elasticloadbalancing:DescribeTags"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "Elb"
          },
          {
            "Action": [
              "ec2:DeleteNatGateway",
              "ec2:DescribeNatGateways",
              "ec2:ReleaseAddress",
              "ec2:DisassociateAddress",
              "ec2:DescribeAddresses"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "Ec2"
          },
          {
            "Action": [
              "lambda:DeleteFunction",
              "lambda:GetFunction",
              "lambda:RemovePermission",
              "lambda:GetPolicy"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "Lambda"
          },
          {
            "Action": [
              "iam:DeleteRole",
              "iam:GetRole",
              "iam:DetachRolePolicy",
              "iam:ListAttachedRolePolicies",
              "iam:ListRolePolicies",
              "iam:DeleteRolePolicy",
              "iam:ListInstanceProfilesForRole"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "IamDemoRole"
          },
          {
            "Action": [
              "tag:GetResources",
              "sts:GetCallerIdentity"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "Audit"
          }
        ]
      }
    }
  ]
}
